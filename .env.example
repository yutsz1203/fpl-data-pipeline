POSTGRES_USER=fpl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fpl
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_JWT_SECRET=change-me
# Linux only: set to the output of `id -u`
# AIRFLOW_UID=1000
# openssl rand -hex 32 for both keys. Never change METABASE_ENCRYPTION_KEY after the first start.
METABASE_DB_PASSWORD=change-me
METABASE_ENCRYPTION_KEY=change-me
METABASE_SESSION_KEY=change-me
METABASE_READER_PASSWORD=change-me
# Metabase admin: 6+ characters with a digit. Metabase rejects common passwords such as change-me.
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=change-me
# Optional: Google Sheet for the Tableau export. Leave empty to skip the export.
GOOGLE_SHEET_ID=
